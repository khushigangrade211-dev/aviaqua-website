# AviAqua Business Management Application - Environment Variables
# Copy to .env for local development or configure in Render Dashboard

# Server Configuration
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Authentication (REQUIRED in production - use a 64+ char random secret)
JWT_SECRET="generate-a-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# PostgreSQL Database (Render PostgreSQL connection string for production)
DATABASE_URL="postgresql://aviaqua_user:password@localhost:5432/aviaqua_db?schema=public"

# Company Defaults (Configurable via Admin Settings)
COMPANY_NAME="NewEdgeEngineeringAndWorks"
COMPANY_CITY="Indore, Madhya Pradesh, India"
COMPANY_PHONE="+91 81096 03077"
COMPANY_EMAIL="newedgeengineeringandworks@gmail.com"
WHATSAPP_NUMBER="918109603077"

# Optional SMTP Email Notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NewEdgeEngineeringAndWorks <newedgeengineeringandworks@gmail.com>"

# Optional Admin Seed Override (only used during initial seed)
ADMIN_EMAIL="admin@aviaqua.in"
ADMIN_PASSWORD="set-a-unique-strong-password-before-first-start"

# Optional Gemini AI Capabilities
GEMINI_API_KEY=""
